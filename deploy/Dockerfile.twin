# syntax=docker/dockerfile:1.4
# Dockerfile.twin -- builds the CesiumJS digital twin (Vite) and serves the static files with nginx.
# Build context: frontend/digital_twin   (see deploy/docker-compose.yml). Tokens are build args, never copied from .env.
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_CESIUM_ION_TOKEN=""
ARG VITE_MAPILLARY_TOKEN=""
ARG VITE_MCP_URL="http://localhost:8010"
ENV VITE_CESIUM_ION_TOKEN=$VITE_CESIUM_ION_TOKEN \
    VITE_MAPILLARY_TOKEN=$VITE_MAPILLARY_TOKEN \
    VITE_MCP_URL=$VITE_MCP_URL
RUN npm run build

FROM nginx:1.27-alpine
# nginx renders /etc/nginx/templates/*.template with env vars at start-up, so Cloud Run's PORT works.
ENV PORT=8080
COPY <<'EOF' /etc/nginx/templates/default.conf.template
server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;
    gzip on;
    gzip_types text/css application/javascript application/json application/geo+json image/svg+xml;
    location / { try_files $uri $uri/ /index.html; }
}
EOF
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080